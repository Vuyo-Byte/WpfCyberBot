<Window x:Class="CyberChatBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyber Chat"
        Height="700"
        Width="950"
        MinHeight="500"
        MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#10121F">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ASCII ART HEADER -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,15">
 
            <TextBlock TextWrapping="NoWrap"
                       FontFamily="Consolas"
                       FontSize="11"
                       Foreground="#00E5FF"
                       TextAlignment="Center">
                <Run Text="  ____      _               ____ _           _   ____        _   "/>
                <LineBreak/>
                <Run Text=" / ___|   _| |__   ___ _ __/ ___| |__   __ _| |_| __ )  ___ | |_"/>
                <LineBreak/>
                <Run Text="| |  | | | | '_ \ / _ \ '__| |   | '_ \ / _` | __|  _ \ / _ \| __|"/>
                <LineBreak/>
                <Run Text="| |__| |_| | |_) |  __/ |  | |___| | | | (_| | |_| |_) | (_) | |_"/>
                <LineBreak/>
                <Run Text=" \____\__, |_.__/ \___|_|   \____|_| |_|\__,_|\__|____/ \___/ \__|"/>
                <LineBreak/>
                <Run Text="      |___/"/>
            </TextBlock>

            <TextBlock Text="CYBERSECURITY CHATBOT"
                       FontSize="23"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,4"/>

            <TextBlock Text="Stay alert. Stay secure."
                       Foreground="#9BA8C7"
                       HorizontalAlignment="Center"
                       FontSize="13"/>
        </StackPanel>

        <!-- CHAT HISTORY -->
        <Border Grid.Row="1"
                Background="#191D30"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,12">

            <ScrollViewer x:Name="ChatScroll"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel x:Name="ChatMessages"/>
            </ScrollViewer>
        </Border>

        <!-- MESSAGE INPUT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="MessageInput"
                     Grid.Column="0"
                     Height="45"
                     FontSize="14"
                     Padding="10"
                     VerticalContentAlignment="Center"
                     Background="#252A40"
                     Foreground="White"
                     BorderBrush="#00E5FF"
                     CaretBrush="White"
                     ToolTip="Type a message"
                     KeyDown="MessageInput_KeyDown"/>

            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Content="Send Message"
                    Margin="10,0,0,0"
                    Height="45"
                    FontWeight="Bold"
                    Background="#00D5F2"
                    Foreground="#10121F"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
